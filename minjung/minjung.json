   "from": "oneline-47"
  },
  {
   "id": "ln_ol48",
   "date": "2026-06-18",
   "time": "07:28",
   "text": "하... 스트레스받네",
   "at": "2026-06-18T07:28:33+09:00",
   "from": "oneline-48"
  },
  {
   "id": "ln_ol51",
   "date": "2026-06-18",
   "time": "11:50",
   "text": "더잘까",
